# API Keys (get from respective services)
FINNHUB_API_KEY=your_finnhub_api_key_here

# JWT Configuration
JWT_SECRET=your_strong_random_secret_key_min_256_bits_long

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=papertrading
DB_USER=postgres
DB_PASSWORD=postgres

# Trading (optional — sensible defaults apply if unset)
# Opening cash for a new account. Recorded on the user at registration, so
# changing it does not alter the performance figures of existing accounts.
STARTING_BALANCE=10000.00
# How long a fetched price stays usable. Keeps portfolio polling inside
# Finnhub's free-tier rate limit.
PRICE_CACHE_TTL_SECONDS=10
